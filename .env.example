# Copy to .env for local back end work. Never commit a real .env file.
# Keys live only in back end environment variables, never in the browser or in the repo.
# The Netlify functions are gated by a site-origin check (see
# netlify/functions/lib/auth.mjs), not by a secret: the front end sends
# no secret, and there is no TRIAGE_SHARED_SECRET variable any more.
# If one is still set in Netlify Site settings, it is unused and can be deleted.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY=
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
# Intake source list, separate from the approved destination above.
# New bugs and feature ideas are pulled from this list. Leave empty until
# the intake list is created in ClickUp; sync then reports it as not set.
CLICKUP_INTAKE_LIST_ID=
# Optional per-pack lists. Each falls back to CLICKUP_LIST_ID when empty.
CLICKUP_LIST_ID_HEALTHCARE=
CLICKUP_LIST_ID_FINTECH=
CLICKUP_LIST_ID_GAMES=
CLICKUP_LIST_ID_ECOMMERCE=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
